# ===== Copie para .env.local (dev) e cadastre as mesmas variáveis na Vercel =====

# OAuth Client ID (tipo "Aplicativo da Web") criado no Google Cloud Console
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Conta de serviço com acesso de EDITOR à planilha
GOOGLE_SERVICE_ACCOUNT_EMAIL=financas@seu-projeto.iam.gserviceaccount.com
# Cole a chave privada do JSON (com os \n literais) entre aspas
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ID da planilha (trecho da URL entre /d/ e /edit)
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Texto aleatório longo para assinar as sessões (ex.: openssl rand -hex 32)
SESSION_SECRET=troque-por-um-segredo-bem-grande

# Usuários permitidos e nomes exibidos
ALLOWED_EMAILS=caio.sarava@gmail.com,thianedepra@gmail.com
USER_NAMES=caio.sarava@gmail.com:Caio,thianedepra@gmail.com:Thiane

# Regra de negócio: e-mails cujo salário recebido no último dia útil do mês conta no 1º dia útil do mês seguinte
# (padrão: thianedepra@gmail.com; separe vários por vírgula)
REGRA_SALARIO_MES_SEGUINTE=thianedepra@gmail.com

# Opcional: nomes completos dos titulares (para reconhecer Pix entre as contas do casal). Se vazio, usa o
# nome do perfil Google guardado no login. Ex.: caio.sarava@gmail.com:Caio Fulano de Tal,thianedepra@gmail.com:Thiane ...
NOMES_COMPLETOS=

# Opcional: chave da API do Claude para ler extratos/faturas em PDF com IA
ANTHROPIC_API_KEY=

# Opcional: Open Finance pelo Meu Pluggy (gratuito para uso pessoal; cada pessoa com a própria conta Pluggy).
# Formato: email:clientId:clientSecret de cada um, separados por vírgula. Guia: https://meu.pluggy.ai/api-guide
PLUGGY_CREDENCIAIS=

# Opcional: análise financeira com IA. Cadastre os valores reais SOMENTE nas variáveis de ambiente da Vercel.
# OpenAI (principal): platform.openai.com/api-keys — a conta precisa ter créditos (Settings → Billing)
OPENAI_API_KEY=
# Opcional: fixar o modelo (padrão gpt-5.4-mini; se indisponível, o app escolhe pela lista da conta)
OPENAI_MODEL=
# NVIDIA (reserva, usada quando a OpenAI falha): build.nvidia.com → Get API Key
NVIDIA_API_KEY=
# Opcional: fixar o modelo da NVIDIA. Vazio = escolhe pela lista (/v1/models), evitando modelos aposentados (410)
NVIDIA_MODEL=
