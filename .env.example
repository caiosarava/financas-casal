# ===== Copie para .env.local (dev) e cadastre as mesmas variáveis na Vercel =====

# OAuth Client ID (tipo "Aplicativo da Web") criado no Google Cloud Console
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Conta de serviço com acesso de EDITOR à planilha
GOOGLE_SERVICE_ACCOUNT_EMAIL=financas@seu-projeto.iam.gserviceaccount.com
# Cole a chave privada do JSON (com os \n literais) entre aspas
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ID da planilha (trecho da URL entre /d/ e /edit)
SHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz

# Texto aleatório longo para assinar as sessões (ex.: openssl rand -hex 32)
SESSION_SECRET=troque-por-um-segredo-bem-grande

# Usuários permitidos e nomes exibidos
ALLOWED_EMAILS=caio.sarava@gmail.com,thianedepra@gmail.com
USER_NAMES=caio.sarava@gmail.com:Caio,thianedepra@gmail.com:Thiane

# Opcional: chave da API do Claude para ler extratos/faturas em PDF com IA
ANTHROPIC_API_KEY=

# Opcional: chave da API do Gemini (Google AI Studio) para a análise financeira com IA
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão: gemini-3.8-flash)
GEMINI_MODEL=
